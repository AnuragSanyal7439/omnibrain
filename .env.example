APP_NAME=OmniBrain
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:8501

DATABASE_URL=sqlite:///./data/omnibrain.db

QDRANT_URL=http://qdrant:6333
QDRANT_TEXT_COLLECTION=omnibrain_text
QDRANT_IMAGE_COLLECTION=omnibrain_images

TEXT_EMBEDDING_PROVIDER=local
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TEXT_EMBEDDING_BATCH_SIZE=32
TEXT_EMBEDDING_DIMENSION=384

CLIP_MODEL=openai/clip-vit-base-patch32
IMAGE_EMBEDDING_BATCH_SIZE=8
IMAGE_EMBEDDING_DIMENSION=512

MAX_UPLOAD_SIZE_MB=50
TEXT_CHUNK_SIZE=800
TEXT_CHUNK_OVERLAP=120

MIN_IMAGE_WIDTH=150
MIN_IMAGE_HEIGHT=150

OPENAI_API_KEY=

